{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/product.schema.json",
    "title": "Utilisation",
    "description": "Utilisation telemetry",
    "type": "object",
    "properties": {
        "required": ["Guid", "utilisation", "time"],
        "Guid": {
            "description": "Globally Unique Identifier inter-networking gateway",
            "type": "Guid"
        },
		"time": {
			"desription" : "Universal time telemetry was published to mqtts.hoshi.property",
			"value" : "setUTCDate()"
		},
		"utilisation": {
            "description": "service utilisation",
            "type": "object",
            "properties": [
                {
                    "description": "Electric branch meter",
                    "topic": "EBM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Electricity meter",
                    "topic": "EM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Virtual electricity meter",
                    "topic": "EMV",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Flow meter",
                    "topic": "FM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Gas meter",
                    "topic": "GM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Virtual gas meter",
                    "topic": "GMV",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "Heat meter",
                    "topic": "HM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "virtal heat meter",
                    "topic": "HMV",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "water meter",
                    "topic": "WM",
                    "value": "number",
                    "service": "string"
                },
                {
                    "description": "virtual water meter",
                    "topic": "WMV",
                    "value": "number",
                    "service": "string"
                }
            ]			
	    }
    }
}
